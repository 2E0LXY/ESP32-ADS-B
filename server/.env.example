# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env - it holds secrets.

# Long random string - used to sign admin/customer login session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Where the SQLite database file lives inside the container. The default
# matches the /data volume mount in docker-compose.yml - only change this
# if you also change that mount.
DATABASE_URL=sqlite:////data/aggregator.db

# Creates the first admin login on first startup only (no-ops once any
# admin user exists in the database). Change your password from the admin
# panel isn't built yet - to rotate it, stop the container, delete the
# admin_users row from the database, set a new password here, and restart.
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-first-boot

# The receiver location this aggregator serves. Every device querying it
# is assumed to want aircraft near this point - fine for a single-operator
# deployment; a multi-location deployment would need this to become a
# per-device parameter instead of a global default.
HOME_LAT=53.73
HOME_LON=-1.57
HOME_RADIUS_NM=50

# How often the background poll loop refreshes from adsb.fi/airplanes.live/
# adsb.lol, in seconds.
POLL_INTERVAL_SECONDS=15

# Upstream sources to leave alone entirely, comma separated: adsbfi,
# airplaneslive, adsblol. airplanes.live is off by default because it answers
# 403 to every request from us - set this to an empty value to try it again.
DISABLED_SOURCES=airplaneslive

# Airline logos (logo.dev). Publishable token - the server holds it so it is
# never sent to a browser, and each logo is fetched once for the whole
# deployment and then served from LOGO_CACHE_DIR. Leave it unset and operator
# badges fall back to initials; nothing else changes.
#
# Left unset, the logo endpoints answer 503 rather than 404, so a receiver
# retries later instead of recording "this airline has no logo" on its own
# card permanently and never asking again.
#
# Free tier requires an attribution link back to logo.dev for commercial use.
# There is one on every page that shows a logo - do not remove it without
# moving to a paid plan.
LOGO_DEV_TOKEN=
LOGO_CACHE_DIR=/data/logos

# Aircraft type photographs. Restricted to CC0 and Public Domain Mark, which
# require no attribution, so there is nothing to credit and no key to obtain.
# Set to 0 to turn them off; the endpoint then answers 503 so receivers retry
# rather than recording "no photo" on their own cards permanently.
AIRCRAFT_PHOTOS=1
PHOTO_CACHE_DIR=/data/photos

# Port range for customer feeder ingestion (one dedicated TCP port per
# feeder-enabled device - see "Feeder ingestion" in README.md). The VPS
# firewall must allow inbound TCP on this whole range, e.g.:
#   sudo ufw allow 30100:30999/tcp
FEEDER_PORT_RANGE_START=30100
FEEDER_PORT_RANGE_END=30999

# How long per-request usage history is kept. One usage_log row is written
# per device poll - about 2,880 rows per device per day, ~95 bytes each with
# indexes - so at 300 receivers this table grows ~82 MB a day and is the
# first thing that would fill the disk. Pruning runs in the background every
# six hours, in small batches so it never holds SQLite's writer lock long
# enough to block a device poll, and each device's most recent row is always
# kept so the dashboard can still show its last result.
USAGE_LOG_RETENTION_DAYS=30

# NOTE: several of the settings above are now editable from the admin panel
# at /admin/settings, and the value there wins once it has been saved. What
# is in this file is where a FRESH deployment starts, not a live override -
# editing it and restarting will not undo a change made in the panel.
# Currently editable there: POLL_INTERVAL_SECONDS, MAX_POLL_REGIONS, the
# maximum area radius, which upstream sources are polled (DISABLED_SOURCES),
# USAGE_LOG_RETENTION_DAYS and AIRCRAFT_PHOTOS. /admin/system lists what
# still needs a restart and why.

# How many recent log lines /admin/logs keeps in memory, per worker. In
# memory only and dropped on restart - the container's own logs are still
# the full history.
# LOG_BUFFER_LINES=2000

# Shared aircraft cache and single-instance lease. Leave this unset for the
# single-worker deployment, which is what this has always been and what the
# measurements below assume - nothing needs Redis to run.
#
# Set it (with the redis service in docker-compose.yml) to serve device polls
# from more than one uvicorn worker. The in-process cache was the reason
# extra vCPU bought nothing: a second worker had its own empty cache and
# served half the receivers nothing. With this set, one worker holds a lease
# and does the work that must happen once - upstream polling and the feeder
# listeners - while all of them answer /v1/aircraft. Then add --workers N to
# the uvicorn command in docker-compose.yml.
#
# REDIS_URL=redis://127.0.0.1:6379/0
# LEADER_LEASE_SECONDS=30
